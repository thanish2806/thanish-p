<div class="custom-banner">
  <h1>{{ section.settings.heading }}</h1>
  <div class="custom-banner__text">{{ section.settings.subtext }}</div>
  <a href="{{ section.settings.button_link }}" class="custom-banner__btn">
    {{ section.settings.button_text }}
  </a>
</div>

{% stylesheet %}
.custom-banner__btn {
  transition: transform 0.2s ease, background-color 0.2s ease;
}
.custom-banner__btn:hover {
  transform: scale(1.05);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Custom Banner" }]
}
{% endschema %}