<div class="gift-banner">
  <div class="gift-banner__topbar">
    <span class="gift-banner__brand">{{ section.settings.brand_name }}</span>
    <span class="gift-banner__topbar-text">{{ section.settings.topbar_text }}</span>
    <a href="{{ section.settings.topbar_btn_link | default: '/collections/all' }}" class="gift-banner__topbar-btn">
      <span>{{ section.settings.topbar_btn_text }}</span>
      <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <div class="gift-banner__hero" style="background-image: url('{% if section.settings.hero_bg != blank %}{{ section.settings.hero_bg | image_url: width: 1800 }}{% else %}{{ 'Frame.png' | asset_url }}{% endif %}');">
    <div class="gift-banner__content">
      <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
      <div class="gift-banner__subtext">
        {% if section.settings.subtext != blank %}
          {{ section.settings.subtext }}
        {% else %}
          <p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
        {% endif %}
      </div>
      <a href="{{ section.settings.shop_btn_link | default: '/collections/all' }}" class="gift-banner__shop-btn">
        <span>{{ section.settings.shop_btn_text }}</span>
        <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="gift-banner__strip">
    <span>{{ section.settings.strip_text }}</span>
  </div>
</div>

{% stylesheet %}
.gift-banner {
  width: 100%;
  font-family: inherit;
}

.gift-banner__topbar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 12px 40px;
  background: #ffffff;
  border-bottom: 1px solid #e5e5e5;
  box-sizing: border-box;
}

.gift-banner__brand {
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: 0.12em;
  color: #000000;
  text-transform: uppercase;
  justify-self: start;
}

.gift-banner__topbar-text {
  font-size: 0.85rem;
  color: #111111;
  font-weight: 500;
  letter-spacing: 0.01em;
  text-align: center;
  justify-self: center;
}

.gift-banner__topbar-btn {
  background: #faea38;
  color: #000000;
  padding: 8px 18px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  justify-self: end;
  border: none;
  transition: all 0.2s ease;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.gift-banner__topbar-btn:hover {
  background: #f0de24;
  transform: translateY(-1px);
}

.gift-banner__hero {
  position: relative;
  background-color: #ffffff;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: right center;
  min-height: 480px;
  display: flex;
  align-items: center;
  padding: 60px 80px;
  box-sizing: border-box;
}

.gift-banner__content {
  max-width: 480px;
  z-index: 2;
}

.gift-banner__heading {
  font-size: 3.25rem;
  font-weight: 800;
  line-height: 1.1;
  color: #000000;
  margin: 0 0 20px 0;
  letter-spacing: -0.02em;
}

.gift-banner__subtext {
  font-size: 0.95rem;
  line-height: 1.55;
  color: #333333;
  margin-bottom: 28px;
}

.gift-banner__subtext p {
  margin: 0;
}

.gift-banner__shop-btn {
  background: #000000;
  color: #ffffff;
  padding: 13px 26px;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  border-radius: 0px;
  transition: all 0.2s ease;
}

.gift-banner__shop-btn:hover {
  background: #222222;
}

.gift-banner__shop-btn .arrow-icon,
.gift-banner__topbar-btn .arrow-icon {
  transition: transform 0.2s ease;
}

.gift-banner__shop-btn:hover .arrow-icon,
.gift-banner__topbar-btn:hover .arrow-icon {
  transform: translateX(4px);
}

.gift-banner__strip {
  background: #f1f1f1;
  text-align: center;
  padding: 14px 20px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #222222;
  text-transform: uppercase;
  border-top: 1px solid #e8e8e8;
  border-bottom: 1px solid #e8e8e8;
}

@media (max-width: 900px) {
  .gift-banner__topbar {
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 16px 20px;
    text-align: center;
  }
  .gift-banner__brand,
  .gift-banner__topbar-text,
  .gift-banner__topbar-btn {
    justify-self: center;
  }
  .gift-banner__hero {
    padding: 40px 24px;
    background-size: cover;
    background-position: center;
    min-height: 380px;
  }
  .gift-banner__heading {
    font-size: 2.3rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gift Banner",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top bar text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "topbar_btn_text", "label": "Top bar button text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "topbar_btn_link", "label": "Top bar button link" },
    { "type": "image_picker", "id": "hero_bg", "label": "Hero background image (defaults to Frame.png)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "shop_btn_text", "label": "Shop button text", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop button link" },
    { "type": "text", "id": "strip_text", "label": "Bottom strip text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Gift Banner" }]
}
{% endschema %}