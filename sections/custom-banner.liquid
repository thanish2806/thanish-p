<style>
.gift-banner {
  width: 100%;
  min-height: 878px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.gift-banner__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 40px;
  background: #f3f3f1;
  box-sizing: border-box;
}

.gift-banner__brand { 
  display: flex;
  align-items: center;
  font-weight: 700;
  font-size: 26px;
  letter-spacing: 2px; 
}

.gift-banner__logo {
  max-width: 220px;
  max-height: 45px;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

.gift-banner__topbar-text {
  font-size: 15px;
  color: #222;
  text-align: center;
}

.gift-banner__topbar-btn {
  position: relative;
  background-color: #f5e13c !important;
  padding: 10px 20px;
  text-decoration: none;
  color: #000000 !important;
  font-weight: 600;
  font-size: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
  z-index: 1;
  border: 1px solid #f5e13c;
  cursor: pointer;
  transition: color 0.35s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease;
}

.gift-banner__topbar-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000000;
  z-index: -1;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.gift-banner__topbar-btn:hover { 
  color: #ffffff !important;
  border-color: #000000;
}

.gift-banner__topbar-btn:hover::before {
  transform: scaleX(1);
}

.gift-banner__topbar-btn .arrow {
  display: inline-block;
  color: inherit !important;
  transition: transform 0.3s ease;
}

.gift-banner__topbar-btn:hover .arrow {
  transform: translateX(4px);
}

.gift-banner__hero {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 40px;
  max-width: 600px;
  box-sizing: border-box;
}

.gift-banner__heading { 
  font-size: 48px; 
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 16px 0; 
  color: #000;
}

.gift-banner__subtext { 
  max-width: 420px; 
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 24px; 
  color: #333;
}

.gift-banner__subtext p {
  margin: 0;
}

.gift-banner__shop-btn {
  background: #000;
  color: #fff;
  padding: 14px 28px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  transition: background-color 0.2s ease;
}

.gift-banner__shop-btn .arrow { 
  transition: transform 0.2s ease; 
}

.gift-banner__shop-btn:hover .arrow { 
  transform: translateX(4px); 
}

.gift-banner__strip {
  text-align: center;
  padding: 14px 20px;
  background: #f3f3f1;
  letter-spacing: 1px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  color: #222;
  box-sizing: border-box;
}

@media (max-width: 749px) {
  .gift-banner {
    min-height: 600px;
  }
  .gift-banner__topbar { 
    flex-direction: column; 
    gap: 12px; 
    padding: 16px 20px; 
    text-align: center;
  }
  .gift-banner__hero { 
    padding: 40px 20px; 
    text-align: center; 
    align-items: center;
    max-width: 100%;
  }
  .gift-banner__heading {
    font-size: 32px;
  }
  .gift-banner__shop-btn { 
    margin: 0 auto; 
  }
}
</style>

<div class="gift-banner" style="background-image: url('{% if section.settings.hero_bg != blank %}{{ section.settings.hero_bg | image_url: width: 1600 }}{% else %}{{ 'hero-bg.png' | asset_url }}{% endif %}');">
  <div class="gift-banner__topbar">
    <div class="gift-banner__brand">
      {% if section.settings.custom_logo != blank %}
        <img
          src="{{ section.settings.custom_logo | image_url: width: 300 }}"
          alt="{{ section.settings.custom_logo.alt | default: 'TISSO VISON' }}"
          class="gift-banner__logo"
          loading="eager"
        >
      {% else %}
        <span>{{ section.settings.brand_name | default: 'TISSO VISON' }}</span>
      {% endif %}
    </div>
    <span class="gift-banner__topbar-text">{{ section.settings.topbar_text | default: 'Find the ideal gift for your loved ones.' }}</span>
    <a href="{{ section.settings.topbar_btn_link | default: '/collections/all' }}" class="gift-banner__topbar-btn">
      {{ section.settings.topbar_btn_text | default: 'CHOOSE GIFT' }}
      <span class="arrow">→</span>
    </a>
  </div>

  <div class="gift-banner__hero">
    <h1 class="gift-banner__heading">{{ section.settings.heading | default: 'The Gift Guide' }}</h1>
    <div class="gift-banner__subtext">
      {% if section.settings.subtext != blank %}
        {{ section.settings.subtext }}
      {% else %}
        <p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
      {% endif %}
    </div>
    <a href="{{ section.settings.shop_btn_link | default: '/collections/all' }}" class="gift-banner__shop-btn">
      {{ section.settings.shop_btn_text | default: 'SHOP NOW' }}
      <span class="arrow">→</span>
    </a>
  </div>

  <div class="gift-banner__strip">{{ section.settings.strip_text | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL' }}</div>
</div>

{% schema %}
{
  "name": "Gift Banner",
  "settings": [
    { "type": "image_picker", "id": "custom_logo", "label": "Custom Logo Image (TISSO VISON)" },
    { "type": "text", "id": "brand_name", "label": "Brand Name (Fallback)", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top Bar Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "topbar_btn_text", "label": "Top Bar Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "topbar_btn_link", "label": "Top Bar Button Link" },
    { "type": "image_picker", "id": "hero_bg", "label": "Hero Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Button Link" },
    { "type": "text", "id": "strip_text", "label": "Bottom Strip Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Gift Banner" }]
}
{% endschema %}