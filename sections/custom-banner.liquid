<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

{% liquid
  assign hero_bg_url = 'hero-bg.png' | asset_url
  if section.settings.hero_bg != blank
    assign hero_bg_url = section.settings.hero_bg | image_url: width: 3840
  endif
%}

<div class="tisso-banner-wrapper">
  <!-- Top Navigation / Announcement Bar -->
  <header class="tisso-topbar">
    <h1 class="gift-banner heading">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading }}">
  {% else %}
    {{ section.settings.heading }}
  {% endif %}
</h1>
    <div class="tisso-topbar__announcement">{{ section.settings.topbar_text | default: 'Find the ideal gift for your loved ones.' }}</div>
    <div class="tisso-topbar__action">
      <a href="{{ section.settings.topbar_btn_link | default: '/collections/all' }}" class="tisso-btn-yellow">
        <span>{{ section.settings.topbar_btn_text | default: 'CHOOSE GIFT' }}</span>
        <svg class="tisso-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </header>

  <!-- Hero Section with New Frame 1957 Background -->
  <section class="tisso-hero" style="background-image: url('{{ hero_bg_url }}');">
    <div class="tisso-hero__bg-wrap" aria-hidden="true">
      <img src="{{ hero_bg_url }}" alt="Gift Guide Hero Background" class="tisso-hero__img" loading="eager">
    </div>

    <div class="tisso-hero__container">
      <div class="tisso-hero__content">
        <h1 class="tisso-hero__title">{{ section.settings.heading | default: 'The Gift Guide' }}</h1>
        <div class="tisso-hero__description">
          {% if section.settings.subtext != blank %}
            {{ section.settings.subtext }}
        </div>
        <a href="{{ section.settings.shop_btn_link | default: '/collections/all' }}" class="tisso-btn-black">
          <span>{{ section.settings.shop_btn_text | default: 'SHOP NOW' }}</span>
          <svg class="tisso-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Sub-Hero Strip Banner -->
  <div class="tisso-strip">
    <div class="tisso-strip__text">{{ section.settings.strip_text | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL' }}</div>
  </div>
</div>

{% stylesheet %}
.tisso-banner-wrapper {
  width: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #000000;
  -webkit-font-smoothing: antialiased;
  position: relative;
}

/* Header Top Bar */
.tisso-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 48px;
  background-color: #ffffff;
  border-bottom: 1px solid #ebebeb;
  box-sizing: border-box;
  min-height: 52px;
  position: relative;
  z-index: 10;
}

.tisso-topbar__brand {
  font-family: 'Inter', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  letter-spacing: 0.08em;
  color: #000000;
  text-transform: uppercase;
  flex: 1;
}

.tisso-topbar__announcement {
  font-size: 0.85rem;
  font-weight: 400;
  color: #222222;
  text-align: center;
  flex: 2;
  letter-spacing: -0.01em;
}

.tisso-topbar__action {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.tisso-btn-yellow {
  background-color: #f7e627;
  color: #000000;
  padding: 8px 20px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.tisso-btn-yellow:hover {
  background-color: #eedc18;
}

.tisso-btn-yellow:hover .tisso-arrow {
  transform: translateX(3px);
}

/* Hero Section */
.tisso-hero {
  position: relative;
  width: 100%;
  min-height: 520px;
  background-color: #ffffff;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1px solid #eaeaea;
  overflow: hidden;
}

/* Layered Image for 100% guarantee of rendering */
.tisso-hero__bg-wrap {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.tisso-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.tisso-hero__container {
  width: 100%;
  max-width: 1320px;
  margin: 0 auto;
  padding: 80px 48px;
  box-sizing: border-box;
  display: flex;
  align-items: left;
  position: relative;
  z-index: 2;
}

.tisso-hero__content {
  top : 200px
  max-width: 440px;
  background: transparent;
  padding: 0;
}

.tisso-hero__title {
  font-family: 'Inter', sans-serif;
  font-size: 3.3rem;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #000000;
  margin: 0 0 18px 0;
}

.tisso-hero__description {
  font-size: 0.9rem;
  line-height: 1.48;
  color: #222222;
  margin-bottom: 26px;
}

.tisso-hero__description p {
  margin: 0;
}

.tisso-btn-black {
  background-color: #000000;
  color: #ffffff;
  padding: 12px 28px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 14px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.tisso-btn-black:hover {
  background-color: #222222;
}

.tisso-btn-black:hover .tisso-arrow {
  transform: translateX(4px);
}

.tisso-arrow {
  transition: transform 0.2s ease;
}

/* Strip Banner */
.tisso-strip {
  width: 100%;
  background-color: #eeeeee;
  padding: 11px 24px;
  text-align: center;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.tisso-strip__text {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #222222;
  text-transform: uppercase;
}

@media (max-width: 900px) {
  .tisso-topbar {
    flex-direction: column;
    gap: 12px;
    padding: 14px 20px;
    text-align: center;
  }
  .tisso-topbar__brand,
  .tisso-topbar__announcement,
  .tisso-topbar__action {
    flex: none;
    width: 100%;
    justify-content: center;
  }
  .tisso-hero {
    min-height: 400px;
  }
  .tisso-hero__container {
    padding: 40px 20px;
  }
  .tisso-hero__content {
    max-width: 100%;
  }
  .tisso-hero__title {
    font-size: 2.4rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Tisso Gift Banner",
  "settings": [
    {"type": "image_picker","id": "image","label": "Banner Image"}
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top Bar Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "topbar_btn_text", "label": "Top Bar Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "topbar_btn_link", "label": "Top Bar Button Link" },
    { "type": "image_picker", "id": "hero_bg", "label": "Hero Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Button Link" },
    { "type": "text", "id": "strip_text", "label": "Bottom Strip Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Tisso Gift Banner" }]
}
{% endschema %}