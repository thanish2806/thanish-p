<style>
/* Base Banner Container */
.gift-banner {
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  position: relative;
}

/* Topbar Desktop */
.gift-banner__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 40px;
  background: #f3f3f1;
  box-sizing: border-box;
  position: relative;
  z-index: 50;
}

.gift-banner__toggle-btn {
  display: none;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 8px;
  align-items: center;
  justify-content: center;
  color: #000000;
  width: 44px;
  height: 44px;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.gift-banner__toggle-icon-open,
.gift-banner__toggle-icon-close {
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.gift-banner__toggle-icon-close {
  display: none !important;
}

.gift-banner__topbar.is-menu-open .gift-banner__toggle-icon-open {
  display: none !important;
}

.gift-banner__topbar.is-menu-open .gift-banner__toggle-icon-close {
  display: flex !important;
}

.gift-banner__brand { 
  display: flex;
  align-items: center;
  font-weight: 700;
  font-size: 24px;
  letter-spacing: 2px; 
  text-transform: uppercase;
  color: #000000;
}

.gift-banner__brand-spacer {
  display: none;
}

.gift-banner__logo {
  max-width: 220px;
  max-height: 40px;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

.gift-banner__topbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  margin-left: 24px;
}

.gift-banner__topbar-text {
  font-size: 15px;
  color: #222222;
  text-align: center;
  flex: 1;
}

.gift-banner__topbar-btn {
  position: relative;
  background-color: #f5e13c !important;
  padding: 10px 22px;
  text-decoration: none;
  color: #000000 !important;
  font-weight: 600;
  font-size: 14px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
  z-index: 1;
  border: 1px solid #f5e13c;
  cursor: pointer;
  transition: color 0.35s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease;
}

.gift-banner__topbar-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000000;
  z-index: -1;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.gift-banner__topbar-btn:hover { 
  color: #ffffff !important;
  border-color: #000000;
}

.gift-banner__topbar-btn:hover::before {
  transform: scaleX(1);
}

.gift-banner__topbar-btn .arrow {
  display: inline-block;
  color: inherit !important;
  transition: transform 0.3s ease;
}

.gift-banner__topbar-btn:hover .arrow {
  transform: translateX(4px);
}

/* Desktop Hero Section */
.gift-banner__hero {
  position: relative;
  width: 100%;
  min-height: 620px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 48px;
  box-sizing: border-box;
}

.gift-banner__hero-inner {
  max-width: 480px;
  z-index: 2;
}

.gift-banner__heading { 
  font-size: 48px; 
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 16px 0; 
  color: #000000;
}

.gift-banner__subtext { 
  max-width: 420px; 
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 28px; 
  color: #222222;
}

.gift-banner__subtext p {
  margin: 0;
}

.gift-banner__desktop-btn-wrap {
  display: block;
}

.gift-banner__hero-media {
  display: none;
}

.gift-banner__shop-btn {
  background: #000000;
  color: #ffffff;
  padding: 14px 32px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  width: fit-content;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  transition: background-color 0.2s ease;
}

.gift-banner__shop-btn:hover {
  background: #222222;
}

.gift-banner__shop-btn .arrow { 
  transition: transform 0.2s ease; 
}

.gift-banner__shop-btn:hover .arrow { 
  transform: translateX(4px); 
}

.gift-banner__strip {
  text-align: center;
  padding: 14px 20px;
  background: #f3f3f1;
  letter-spacing: 1px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  color: #222222;
  box-sizing: border-box;
}

/* Mobile Responsive Styling (Matches Design Screenshot 1 & 2) */
@media (max-width: 768px) {
  .gift-banner__topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #f3f3f1;
    position: relative;
  }

  .gift-banner__toggle-btn {
    display: flex !important;
    z-index: 20;
  }

  .gift-banner__brand {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
    letter-spacing: 2px;
    margin: 0;
    text-align: center;
  }

  .gift-banner__brand-spacer {
    display: block;
    width: 44px;
    height: 44px;
  }

  /* Mobile Dropdown Panel */
  .gift-banner__topbar-content {
    display: none;
    width: 100%;
    margin-left: 0;
    flex-direction: column;
    padding: 24px 16px 28px 16px;
    background: #f3f3f1;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
    text-align: center;
    gap: 16px;
    animation: tissoMenuFade 0.25s ease-out;
  }

  .gift-banner__topbar.is-menu-open .gift-banner__topbar-content {
    display: flex !important;
  }

  .gift-banner__topbar-text {
    font-size: 15px;
    color: #222222;
    margin: 0;
    line-height: 1.4;
  }

  .gift-banner__topbar-btn {
    width: 100%;
    max-width: 320px;
    justify-content: center;
    padding: 13px 20px;
    font-size: 14px;
    margin: 0 auto;
  }

  /* Hero Section on Mobile */
  .gift-banner__hero {
    min-height: auto;
    padding: 36px 16px 0 16px;
    background-image: none !important;
    text-align: center;
    align-items: center;
  }

  .gift-banner__hero-inner {
    max-width: 100%;
    margin-bottom: 20px;
  }

  .gift-banner__heading {
    font-size: 32px;
    line-height: 1.15;
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .gift-banner__subtext {
    font-size: 15px;
    line-height: 1.45;
    max-width: 320px;
    margin: 0 auto;
  }

  .gift-banner__desktop-btn-wrap {
    display: none;
  }

  /* Mobile Artwork with Centered SHOP NOW button */
  .gift-banner__hero-media {
    display: block;
    position: relative;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
  }

  .gift-banner__hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .gift-banner__shop-btn-wrap {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 10;
  }

  .gift-banner__shop-btn {
    padding: 13px 28px;
    font-size: 13px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .gift-banner__strip {
    padding: 12px 16px;
    font-size: 12px;
    letter-spacing: 0.8px;
  }
}

@keyframes tissoMenuFade {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<div class="gift-banner">
  <!-- Topbar Header with Mobile Hamburger Menu Toggle -->
  <div class="gift-banner__topbar" id="giftBannerTopbar">
    <button
      type="button"
      class="gift-banner__toggle-btn"
      id="giftBannerToggle"
      aria-label="Toggle Menu"
      aria-expanded="false"
      onclick="window.toggleGiftBannerMenu(this, event)"
    >
      <!-- Hamburger Icon (Closed state) -->
      <span class="gift-banner__toggle-icon-open">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </span>
      <!-- Close Icon (Open state) -->
      <span class="gift-banner__toggle-icon-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </span>
    </button>

    <div class="gift-banner__brand">
      {% if section.settings.custom_logo != blank %}
        <img
          src="{{ section.settings.custom_logo | image_url: width: 300 }}"
          alt="{{ section.settings.custom_logo.alt | default: 'TISSO VISON' }}"
          class="gift-banner__logo"
          loading="eager"
        >
      {% else %}
        <span>{{ section.settings.brand_name | default: 'TISSO VISON' }}</span>
      {% endif %}
    </div>

    <!-- Spacer for symmetrical balance on mobile -->
    <div class="gift-banner__brand-spacer" aria-hidden="true"></div>

    <!-- Topbar Content: Announcement & Button (Dropdown on mobile) -->
    <div class="gift-banner__topbar-content" id="giftBannerTopbarContent">
      <span class="gift-banner__topbar-text">{{ section.settings.topbar_text | default: 'Find the ideal gift for your loved ones.' }}</span>
      {% liquid
        assign topbar_url = '#tisso-lookbook'
        if section.settings.topbar_btn_link != blank
          assign topbar_url = section.settings.topbar_btn_link
        endif
      %}
      <a href="{{ topbar_url }}" class="gift-banner__topbar-btn" data-tisso-nav="{{ topbar_url }}">
        <span>{{ section.settings.topbar_btn_text | default: 'CHOOSE GIFT' }}</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>

  {% liquid
    assign hero_bg_url = 'hero-bg.png' | asset_url
    if section.settings.hero_bg != blank
      assign hero_bg_url = section.settings.hero_bg | image_url: width: 1600
    endif

    assign shop_url = '#tisso-lookbook'
    if section.settings.shop_btn_link != blank
      assign shop_url = section.settings.shop_btn_link
    endif
  %}

  <!-- Hero Section -->
  <div class="gift-banner__hero" style="background-image: url('{{ hero_bg_url }}');">
    <div class="gift-banner__hero-inner">
      <h1 class="gift-banner__heading">{{ section.settings.heading | default: 'The Gift Guide' }}</h1>
      <div class="gift-banner__subtext">
        {% if section.settings.subtext != blank %}
          {{ section.settings.subtext }}
        {% else %}
          <p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
        {% endif %}
      </div>
      <div class="gift-banner__desktop-btn-wrap">
        <a href="{{ shop_url }}" class="gift-banner__shop-btn" data-tisso-nav="{{ shop_url }}">
          <span>{{ section.settings.shop_btn_text | default: 'SHOP NOW' }}</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>

    <!-- Mobile Artwork & SHOP NOW Button Container -->
    <div class="gift-banner__hero-media">
      <img src="{{ hero_bg_url }}" alt="{{ section.settings.heading | default: 'The Gift Guide' }}" class="gift-banner__hero-img" loading="eager">
      <div class="gift-banner__shop-btn-wrap">
        <a href="{{ shop_url }}" class="gift-banner__shop-btn" data-tisso-nav="{{ shop_url }}">
          <span>{{ section.settings.shop_btn_text | default: 'SHOP NOW' }}</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Strip Banner -->
  <div class="gift-banner__strip">{{ section.settings.strip_text | default: 'SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR' }}</div>
</div>

<script>
window.toggleGiftBannerMenu = function(btn, event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const topbar = document.getElementById('giftBannerTopbar') || (btn ? btn.closest('.gift-banner__topbar') : null);
  const toggleBtn = btn || document.getElementById('giftBannerToggle');
  if (topbar) {
    const isOpen = topbar.classList.toggle('is-menu-open');
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
  }
};

// Global delegation listener for menu toggle & button navigation
document.addEventListener('click', function(e) {
  const toggle = e.target.closest('#giftBannerToggle, .gift-banner__toggle-btn');
  if (toggle) {
    window.toggleGiftBannerMenu(toggle, e);
    return;
  }

  const navBtn = e.target.closest('[data-tisso-nav]');
  if (navBtn) {
    const target = navBtn.getAttribute('data-tisso-nav') || navBtn.getAttribute('href');
    if (target === '#tisso-lookbook') {
      const targetEl = document.getElementById('tisso-lookbook') || document.querySelector('.tisso-lookbook-wrapper');
      if (targetEl) {
        e.preventDefault();
        targetEl.scrollIntoView({ behavior: 'smooth' });
      }
    } else if (target && target !== '#' && !target.startsWith('#')) {
      window.location.href = target;
    }
  }
});
</script>

{% schema %}
{
  "name": "Gift Banner",
  "settings": [
    { "type": "image_picker", "id": "custom_logo", "label": "Custom Logo Image (TISSO VISON)" },
    { "type": "text", "id": "brand_name", "label": "Brand Name (Fallback)", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top Bar Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "topbar_btn_text", "label": "Top Bar Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "topbar_btn_link", "label": "Top Bar Button Link" },
    { "type": "image_picker", "id": "hero_bg", "label": "Hero Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Button Link" },
    { "type": "text", "id": "strip_text", "label": "Bottom Strip Text", "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR" }
  ],
  "presets": [{ "name": "Gift Banner" }]
}
{% endschema %}